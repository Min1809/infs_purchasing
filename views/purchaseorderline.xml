<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_order_form_inherit_delay" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.delay</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//field[@name='product_qty']"
                    position="before">
                    <field name="delay_supplier" string="Delivery Terms" readonly="parent.approval_stage != 'draft'"/>
                </xpath>
            </field>
        </record>

