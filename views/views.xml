<odoo>

  <!-- RFQ menu -->
  
    <record id="infs_action_rfq_l1" model="ir.actions.act_window">
        <field name="name">L1 Pending</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('approval_stage', '=', 'submitted'), ('state', 'in', ['draft', 'sent']), ('purchase_group_id', '=', False)]</field>
    </record>
  
    <record id="infs_action_rfq_l2" model="ir.actions.act_window">
        <field name="name">L2 Pending</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('approval_stage', '=', 'approved_lvl_1'), ('purchase_group_id', '=', False)]</field>
    </record>
  
    <record id="infs_action_rfq_l3" model="ir.actions.act_window">
        <field name="name">L3 Pending</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('approval_stage', '=', 'approved_lvl_2'), ('purchase_group_id', '=', False)]</field>
    </record>

    <record id="action_menu_infs_single_rfq_all" model="ir.actions.act_window">
        <field name="name">All Single RFQs</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', 'in', ['draft', 'sent']), ('purchase_group_id', '=', False)]</field>
    </record>

    <record id="action_menu_infs_rfq_all" model="ir.actions.act_window">
        <field name="name">All RFQs</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', 'in', ['draft', 'sent'])]</field>
    </record>
  
    <!-- RFQs Menu -->
    <menuitem id="infs_menu__rfq"
        name="RFQs"
        parent="purchase.menu_purchase_root"
        sequence="6" />

    <menuitem id="infs_menu_rfq_list_all"
        name="All RFQs"
        parent="infs_menu__rfq"
        action="action_menu_infs_rfq_all"
        sequence="10" />

    <menuitem id="infs_menu_single_rfq_list_all"
        name="All Single RFQs"
        parent="infs_menu__rfq"
        action="action_menu_infs_single_rfq_all"
        sequence="15" />

    <menuitem id="infs_menu_rfq_l1"
        name="RFQ : Approve L1"
        parent="infs_menu__rfq"
        action="infs_action_rfq_l1"
        groups="infs_purchasing.purchase_supervisor_level_1"
        sequence="20" />

    <menuitem id="infs_menu_rfq_l2"
        name="RFQ : Approve L2"
        parent="infs_menu__rfq"
        action="infs_action_rfq_l2"
        groups="infs_purchasing.purchase_supervisor_level_2"
        sequence="30" />

    <menuitem id="infs_menu_rfq_l3"
        name="RFQ : Approve L3"
        parent="infs_menu__rfq"
        action="infs_action_rfq_l3"
        groups="infs_purchasing.purchase_supervisor_level_3"
        sequence="40" />

  <!-- RFQ Groups menu -->
  
    <record id="infs_action_rfq_group_l1" model="ir.actions.act_window">
        <field name="name">L1 Pending</field>
        <field name="res_model">purchase.order.group</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('approval_stage', '=', 'submitted')]</field>
    </record>
  
    <record id="infs_action_rfq_group_l2" model="ir.actions.act_window">
        <field name="name">L2 Pending</field>
        <field name="res_model">purchase.order.group</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('approval_stage', '=', 'approved_lvl_1')]</field>
    </record>
  
    <record id="infs_action_rfq_group_l3" model="ir.actions.act_window">
        <field name="name">L3 Pending</field>
        <field name="res_model">purchase.order.group</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('approval_stage', '=', 'approved_lvl_2')]</field>
    </record>

    <record id="action_menu_infs_rfq_group_all" model="ir.actions.act_window">
        <field name="name">All RFQ Groups</field>
        <field name="res_model">purchase.order.group</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
    </record>
  
    <!-- RFQ Groups Menu -->
    <menuitem id="infs_menu__rfq_group"
        name="RFQ Groups"
        parent="purchase.menu_purchase_root"
        sequence="7" />

    <menuitem id="infs_menu_rfq_group_list_all"
        name="All RFQ Groups"
        parent="infs_menu__rfq_group"
        action="action_menu_infs_rfq_group_all"
        sequence="10" />

    <menuitem id="infs_menu_rfq_group_l1"
        name="RFQ Group : Approve L1"
        parent="infs_menu__rfq_group"
        action="infs_action_rfq_group_l1"
        groups="infs_purchasing.purchase_supervisor_level_1"
        sequence="20" />

    <menuitem id="infs_menu_rfq_group_l2"
        name="RFQ Group : Approve L2"
        parent="infs_menu__rfq_group"
        action="infs_action_rfq_group_l2"
        groups="infs_purchasing.purchase_supervisor_level_2"
        sequence="30" />

    <menuitem id="infs_menu_rfq_group_l3"
        name="RFQ Group : Approve L3"
        parent="infs_menu__rfq_group"
        action="infs_action_rfq_group_l3"
        groups="infs_purchasing.purchase_supervisor_level_3"
        sequence="40" />

</odoo>
