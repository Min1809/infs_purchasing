<odoo>
    <record id="view_purchase_order_form_inherit_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.approval.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">

            <xpath expr="//header/button[@name='action_rfq_send']" position="before">
                <button name="check_stage_and_approve_after_confirmed" type="object"
                    string="Submit for Approval"
                    class="oe_highlight"
                    invisible="approval_stage != 'draft'" />
            </xpath>

            <xpath expr="//header/button[@name='action_rfq_send']" position="before">
                <button name="check_stage_and_approve_after_confirmed" type="object"
                    string="RFQ Approve L1"
                    class="oe_highlight"
                    group="infs_purchasing.purchase_supervisor_level_1"
                    invisible="approval_stage != 'submitted'" />
            </xpath>

            <xpath expr="//header/button[@name='action_rfq_send']" position="before">
                <button name="check_stage_and_approve_after_confirmed" type="object"
                    string="RFQ Approve L2"
                    class="oe_highlight"
                    group="infs_purchasing.purchase_supervisor_level_2"
                    invisible="approval_stage != 'approved_lvl_1'" />
            </xpath>

            <xpath expr="//header/button[@name='action_rfq_send']" position="before">
                <button name="check_stage_and_approve_after_confirmed" type="object"
                    string="RFQ Approve L3"
                    class="oe_highlight"
                    group="infs_purchasing.purchase_supervisor_level_3"
                    invisible="approval_stage != 'approved_lvl_2'" />
            </xpath>

            <xpath expr="//div[@name='reminder']" position="after">
                <field name="approval_status" readonly="1" />
                <field name="approval_stage" readonly="1" invisible="1" />
            </xpath>

            <xpath expr="(//button[@name='button_confirm'])[1]" position="replace">
                <button name="button_confirm" type="object"
                    invisible="state != 'sent' or approval_stage != 'approved'"
                    string="Confirm Order" context="{'validate_analytic': True}"
                    class="oe_highlight"
                    id="bid_confirm" data-hotkey="q" />
            </xpath>

            <xpath expr="(//button[@name='button_confirm'])[2]" position="replace">
                <button name="button_confirm" type="object"
                    invisible="state != 'draft' or approval_stage != 'approved'"
                    context="{'validate_analytic': True}" string="Confirm Order" id="draft_confirm"
                    data-hotkey="q" />
            </xpath>

            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">approval_stage in ('submitted', 'approved_lvl_1',
                    'approved_lvl_2', 'approved')</attribute>
                <!-- <attribute name="readonly">state != 'purchase'</attribute> -->
            </xpath>

            <xpath
                expr="//page[@name='products']//field[@name='order_line']//field[@name='product_qty']"
                position="attributes">
                <attribute name="readonly">parent.approval_stage != 'draft'</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']"
                position="attributes">
                <attribute name="readonly">parent.approval_stage == 'confirmed'</attribute>
            </xpath>

            <xpath expr="//form[@class='o_purchase_order']/header/field[@name='state']"
                position="replace">
                <field name="state"
                    widget="statusbar"
                    statusbar_visible="draft,approved,sent,purchase"
                    readonly="1"
                    on_change="1" />
            </xpath>

            <!-- header buttons update for state=approved-->

            <!-- <xpath expr="(//header/button[@name='action_rfq_send'])[1]" position="replace">
                <button name="action_rfq_send" invisible="state != 'approved'"
                    string="Send by Email"
                    type="object"
                    context="{'send_rfq':True}" class="oe_highlight" data-hotkey="g" />
            </xpath>

            <xpath expr="//header/button[@name='button_cancel']" position="replace">
                <button name="button_cancel"
                    invisible="state not in ('draft', 'approved', 'to approve', 'sent', 'purchase')"
                    string="Cancel"
                    type="object" data-hotkey="x" />
            </xpath> -->

        </field>
    </record>
</odoo>